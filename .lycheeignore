# Configuration lychee - URLs à ignorer
# Documentation: https://github.com/lycheeverse/lychee
# Ce fichier est lu automatiquement par lychee
#
# >>> GENERATED FROM .vscode/tasks/link_whitelist.txt - ne pas editer a la main >>>
# (regénéré par : python3 .vscode/tasks/generate_link_configs.py)

# Whitelist commune des liens ignorés par tous les outils de vérification
# (scripts maison Python, htmlproofer, lychee).
#
# Un regex par ligne, '#' = commentaire.
# Syntaxe commune Python / Ruby / Rust (regex crate) :
# - pas de {n,m} (htmlproofer découpe --ignore-urls sur les virgules)
# - pas de guillemets simples (le snippet shell généré les utilise)
#
# Lu directement par les scripts maison (check_links_lib.py).
# Après modification, lancer la tâche "🔧 Mettre à jour la whitelist des liens"
# (ou : python3 .vscode/tasks/generate_link_configs.py)
# pour régénérer les configurations d'htmlproofer et lychee.
# Ancres
^#
# Protocoles non-HTTP
^mailto:.*
^tel:.*
^apt://.*
^apt-thirdparty://.*
^snap://.*
^flatpak\+https://.*
# Projets externes / exemples
^JaMuz$
^https?://utilisateur:motdepasse@monproxy:leport/?([?#].*)?$
# Services locaux
^https?://localhost(:[0-9]+)?([/?#].*)?$
^https?://[a-zA-Z0-9.-]+\.local(:[0-9]+)?([/?#].*)?$
^https?://(10\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+)(:[0-9]+)?([/?#].*)?$
# Sites avec filtrage anti-robot (403/406 systématique pour les scripts)
^https?://([a-zA-Z0-9-]+\.)*(stackoverflow\.com|alternativeto\.net|distrowatch\.com|kobo\.com|raspberrypi\.com|samfw\.com|gitlab\.gnome\.org|ubunlog\.com|apkmirror\.com|sourceforge\.(net|io)|dev\.mysql\.com)(/|$)
# Hôte IPv6-only : injoignable depuis le dev container (faux positif environnemental)
^https?://git\.codecoop\.org(/|$)
# Certificat TLS invalide (hostname mismatch) mais site vivant
^https?://([a-zA-Z0-9-]+\.)*gftp\.org(/|$)

# <<< END GENERATED <<<

# Motifs spécifiques à lychee (analyse du site généré _site/)
# Assets locaux (existants sur le serveur web, pas forcément dans _site)
^/assets/.*
# Fichier JSON généré
^/search\.json.*
