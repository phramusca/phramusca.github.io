# Configuration lychee - URLs à ignorer
# Documentation: https://github.com/lycheeverse/lychee
# Ce fichier est lu automatiquement par lychee

# Ignorer les ancres (fragments)
^#.*$

# Ignorer les liens mailto
^mailto:.*

# Ignorer les liens tel
^tel:.*

# Ignorer les assets (CSS, JS, images) - fonctionnent sur le serveur web mais pas en local
^/assets/.*

# Ignorer les fichiers JSON générés
^/search\.json.*

# Ignorer les liens vers des projets externes (exemples)
^JaMuz$

# Ignorer les services locaux mDNS (.local), ex: rpi5.local
^https?://[a-zA-Z0-9.-]+\.local(:[0-9]+)?(/|$)

# Ignorer les sites avec filtrage anti-robot (403 systématique)
^https?://([a-zA-Z0-9-]+\.)*(stackoverflow\.com|alternativeto\.net|distrowatch\.com|kobo\.com|raspberrypi\.com|samfw\.com)(/|$)

